# Copy to .env.local and fill in locally. Never commit .env.local.
APP_URL=http://localhost:1222
AUTH_USER=choose-a-username
AUTH_PASS=choose-a-long-random-password
SESSION_SECRET=replace-with-at-least-32-random-bytes
QUIZ_API_KEY=replace-with-an-independent-long-random-value

# Optional push notifications. Leave unset if unused.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.invalid
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Optional private instruction route. Leave unset if unused.
# INSTRUCTION_SLUG=
# INSTRUCTION_PASSWORD=

# The pilot keeps a separate database. Set an absolute path to place it outside
# the checkout, or leave unset for private/pilot-learning.db.
# TUTOR_DB_PATH=/path/to/private/pilot-learning.db

# ChatGPT plan usage is intentionally unavailable in this source release.
# The official SIWC integration will be added only after eligibility approval.
